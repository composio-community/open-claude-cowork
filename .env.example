# Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=your-api-key-here

# Composio API key for Tool Router
COMPOSIO_API_KEY=your-composio-api-key-here

# Brave Search API Key for LLM context search
BRAVE_API_KEY=your-brave-api-key-here

# ClickUp MCP Server URL and optional Bearer token (ClickUp MCP uses OAuth 2.0 by default if no token is provided)
CLICKUP_MCP_URL=https://mcp.clickup.com/mcp
CLICKUP_API_KEY=

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

