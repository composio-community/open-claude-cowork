{
  "name": "open-claude-cowork",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "NODE_ENV=development electron .",
    "start": "electron .",
    "web": "node server/server.js",
    "docker:build": "docker build -t open-claude-cowork:local .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "cloudrun:emulate": "gcloud beta code dev --service-config=cloudrun-service.yaml",
    "cloudrun:deploy": "gcloud run deploy open-claude-cowork --source . --port 8080 --allow-unauthenticated",
    "test": "node --test"
  },
  "author": "",
  "license": "ISC",
  "description": "Electron chat app with Claude Agent SDK and Opencode SDK support",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.7",
    "@opencode-ai/sdk": "latest",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-reload": "^2.0.0-alpha.1"
  }
}
